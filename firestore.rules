rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Server-authoritative email verification at the rules layer (audit M2).
    // A password-provider account must have a verified email (from the auth
    // TOKEN, never the client-writable users/{uid}.needsEmailVerification) to
    // reach sensitive couple-scoped data. Federated providers (google.com,
    // apple.com, …) are not 'password' and are always allowed. This is ANDed
    // into every couple-membership grant below, so an already-paired but
    // unverified password account is denied couple access even though it is
    // still listed in couples.members. Own users/{uid} access, pairing/leave
    // callables, and the login/verification screen are unaffected.
    function passwordVerified() {
      return request.auth != null && (
        request.auth.token.firebase.sign_in_provider != 'password'
        || request.auth.token.email_verified == true
      );
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Read: yourself (always), or your partner once you are both members of
      // the same couple. There is intentionally NO general "any signed-in user"
      // clause. The join handshake no longer reads the inviter's user doc — the
      // "inviter already partnered" guard moved to the cross-user update rule
      // below (coupleId == null), so nothing legitimately needs to read a
      // stranger's profile.
      //
      // M2: the PARTNER-read branch also requires passwordVerified(), so an
      // already-paired but unverified password account cannot read its
      // partner's user document (email, fcmToken, …). Owner self-read is never
      // gated — the login/verification screen must always read its own doc.
      allow read: if request.auth.uid == userId
        || (passwordVerified()
            && resource.data.coupleId != null
            && request.auth.uid in get(
                 /databases/$(database)/documents/couples/$(resource.data.coupleId)
               ).data.members);
      allow create, delete: if request.auth.uid == userId;
      // Own document only, and ONLY client-owned profile / preference fields.
      // Server-owned identity and lifecycle fields (uid, email, createdAt) and
      // the relationship pointer are NOT arbitrarily client-writable: pairing
      // sets coupleId to a couple via the Admin SDK (joinCouple/createInvite),
      // and the only legitimate client write of coupleId is the _CoupleGate /
      // ensureUserDoc self-heal that clears a stale pointer to null. So a
      // strict hasOnly() allowlist gates the writable fields, and coupleId may
      // only ever transition TO null — never to an arbitrary couple id, which
      // is what the deleteAccount / Storage authorization bugs relied on.
      //
      // NOTE: needsEmailVerification is currently client-written by the email
      // verification screen; it is left writable here so that in-scope flow is
      // not broken. Making it fully server-owned is audit finding M2 (email
      // verification), deliberately out of scope for this patch.
      allow update: if request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'displayName', 'avatarUrl', 'language', 'timeZone', 'fcmToken',
             'savedIdeaIds', 'needsEmailVerification', 'coupleId',
             'relationshipRemindersVersion', 'smartRemindersEnabled',
             'qualityTimeReminderEnabled', 'dateReminderEnabled',
             'weeklyRelationshipReminderEnabled', 'partnerMessagesEnabled'
           ])
        && (
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coupleId'])
             || request.resource.data.coupleId == null
           );
    }

    // ── Couples ───────────────────────────────────────────────────────────────
    match /couples/{coupleId} {
      // Create is server-only: the createInvite Cloud Function creates the
      // pending couple doc with the Admin SDK. The client only joins (update)
      // or cancels (delete) an existing couple — it never creates one. This
      // also means clients cannot seed a server-owned field like
      // subscriptionTier at creation.
      allow create: if false;

      // Read: existing members only. Joining is fully server-side (the
      // joinCouple callable reads the pending couple with the Admin SDK, which
      // bypasses these rules), so a client never needs to read a couple it is
      // not a member of. The former "anyone authenticated may read a pending
      // couple" branch was unnecessary client exposure — a stranger who
      // learned a pending coupleId could read its members — and is removed.
      allow read: if request.auth != null
        && passwordVerified()
        && request.auth.uid in resource.data.members;

      // Update: existing members only, and ONLY the client-owned fields.
      // Membership and lifecycle (members, status, inviteCode, activatedAt,
      // createdAt) and entitlement (subscriptionTier) are server-authoritative
      // — set exclusively by the joinCouple / createInvite / dissolveCouple
      // Admin-SDK paths, which bypass these rules. A client may therefore only
      // touch the couple-owned relationship fields it legitimately writes:
      //   streakRecord         (FirestoreService.updateStreakRecord)
      //   togetherSince        (FirestoreService.setTogetherSince)
      //   togetherSinceProposal(anniversary propose/approve flow)
      // A strict hasOnly() allowlist means a client can NEVER add a third
      // member, remove their partner, replace members, change status, alter
      // the invite identity, or self-grant a subscription.
      allow update: if request.auth != null
        && passwordVerified()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['streakRecord', 'togetherSince', 'togetherSinceProposal']);

      // Delete: existing members only (used by cancelInvite).
      allow delete: if request.auth != null &&
        request.auth.uid in resource.data.members;

      // Subcollections: settings, lastTime, weeklyPlan, …
      //
      // `messages` and `chat` are carved OUT of this generic grant and get
      // their own stricter rules below. Overlapping matches are additive in
      // Firestore rules, so a broad allow here cannot be narrowed later — it
      // has to exclude them explicitly.
      match /{subcollection}/{docId} {
        allow read, write: if subcollection != 'messages'
          && subcollection != 'chat'
          && subcollection != 'settings'
          && subcollection != 'mediations'
          && request.auth != null
          && passwordVerified()
          && request.auth.uid in get(
            /databases/$(database)/documents/couples/$(coupleId)
          ).data.members;
      }

      // ── Settings ─────────────────────────────────────────────────────────
      // settings/main: couple-level document (legacy onboarding summary,
      // lifestyle, reminder toggles) — any member may read and write it.
      // settings/prefs_{uid}: ONE user's raw onboarding answers. Both
      // partners may read both, but a user may only create/update/delete
      // their own — a partner can never overwrite the other's answers.
      // Everything else under settings/ is closed.
      match /settings/{docId} {
        function isSettingsMember() {
          return request.auth != null
            && passwordVerified()
            && request.auth.uid in get(
              /databases/$(database)/documents/couples/$(coupleId)
            ).data.members;
        }
        function isOwnPrefs() {
          return docId == 'prefs_' + request.auth.uid;
        }
        function isValidPrefs() {
          let d = request.resource.data;
          return d.keys().hasOnly([
              'locationPreferences', 'pace', 'availableTime', 'isParent',
              'childcareState', 'bedtimeWeekday', 'bedtimeWeekend',
              'updatedAt', 'completedAt', 'schemaVersion'])
            && (!('locationPreferences' in d) || (d.locationPreferences is list && d.locationPreferences.size() <= 4))
            && (!('availableTime' in d) || d.availableTime in ['fewHours', 'evening', 'fullDay'])
            && (!('childcareState' in d) || d.childcareState in ['kidsHome', 'kidFree'])
            && (!('pace' in d) || d.pace in ['calm', 'mixed', 'active'])
            && (!('isParent' in d) || d.isParent is bool)
            && (!('bedtimeWeekday' in d) || d.bedtimeWeekday is string)
            && (!('bedtimeWeekend' in d) || d.bedtimeWeekend is string);
        }
        allow read: if isSettingsMember();
        allow write: if docId == 'main' && isSettingsMember();
        allow create, update: if docId.matches('^prefs_.*$') && isSettingsMember() && isOwnPrefs() && isValidPrefs();
        allow delete: if docId.matches('^prefs_.*$') && isSettingsMember() && isOwnPrefs();
      }

      // ── Mediation ("Oss mot problemet") ──────────────────────────────────
      // mediations/{m}: server-written; members read (category, status,
      // who has submitted, summary, agreement). Never the raw answers.
      // mediations/{m}/private/{uid}: ONE user's private draft — owner only,
      // while the talk is being answered, draft:true only; the server locks
      // (draft:false, submittedAt) and later deletes it.
      // mediations/{m}/server/* and safety/*: server-only, no rule.
      match /mediations/{mediationId} {
        function isMedMember() {
          return request.auth != null
            && passwordVerified()
            && request.auth.uid in get(
              /databases/$(database)/documents/couples/$(coupleId)
            ).data.members;
        }
        function medStatus() {
          return exists(/databases/$(database)/documents/couples/$(coupleId)/mediations/$(mediationId))
            ? get(/databases/$(database)/documents/couples/$(coupleId)/mediations/$(mediationId)).data.status
            : '';
        }
        // One private draft per user, whose kind must match the stage:
        //   topic    (initiator, while drafting)     — topic + wish
        //   answer   (partner, while answering)      — view + need
        //   feedback (either, while a round is open) — happy|almost + addition
        function boundedStr(d, k, max) {
          return !(k in d) || (d[k] is string && d[k].size() <= max);
        }
        function isValidDraft() {
          let d = request.resource.data;
          return d.draft == true
            && d.keys().hasOnly(['kind', 'round', 'topic', 'wish', 'view', 'need', 'feedback', 'addition', 'draft', 'updatedAt'])
            && (
              (d.kind == 'topic' && medStatus() == 'drafting'
                && d.keys().hasOnly(['kind', 'topic', 'wish', 'draft', 'updatedAt'])
                && boundedStr(d, 'topic', 1000) && boundedStr(d, 'wish', 1000))
              || (d.kind == 'answer' && medStatus() == 'answering'
                && d.keys().hasOnly(['kind', 'view', 'need', 'draft', 'updatedAt'])
                && boundedStr(d, 'view', 1000) && boundedStr(d, 'need', 1000))
              || (d.kind == 'feedback' && medStatus() == 'round'
                && d.keys().hasOnly(['kind', 'round', 'feedback', 'addition', 'draft', 'updatedAt'])
                && (!('feedback' in d) || d.feedback in ['happy', 'almost'])
                && (!('round' in d) || d.round is int)
                && boundedStr(d, 'addition', 300))
            );
        }
        allow read: if isMedMember();
        allow write: if false;

        match /private/{uid} {
          allow read: if isMedMember() && request.auth.uid == uid;
          allow create: if isMedMember() && request.auth.uid == uid && isValidDraft();
          allow update: if isMedMember() && request.auth.uid == uid
            && resource.data.draft == true && isValidDraft();
          allow delete: if false;
        }
      }

      // ── Chat ────────────────────────────────────────────────────────────
      // Membership is re-read from the couple document on every request, so
      // a former partner loses access the instant disconnectPartner removes
      // them from `members` — there is no cached grant to revoke.
      function isCoupleMember() {
        return request.auth != null
          && passwordVerified()
          && request.auth.uid in get(
            /databases/$(database)/documents/couples/$(coupleId)
          ).data.members;
      }

      function isValidTextMessage() {
        return request.resource.data.type == 'text'
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(
               ['senderId', 'type', 'text', 'createdAt', 'clientTs']);
      }

      function isValidIdeaMessage() {
        let idea = request.resource.data.idea;
        return request.resource.data.type == 'idea'
          && idea is map
          && idea.titleNo is string && idea.titleEn is string
          && idea.categoryNo is string && idea.categoryEn is string
          && idea.metaNo is string && idea.metaEn is string
          && idea.descriptionNo is string && idea.descriptionEn is string
          && (!('coverImageUrl' in idea) || idea.coverImageUrl is string)
          && idea.keys().hasOnly([
               'titleNo', 'titleEn', 'categoryNo', 'categoryEn',
               'metaNo', 'metaEn', 'descriptionNo', 'descriptionEn',
               'coverImageUrl'])
          && request.resource.data.keys().hasOnly(
               ['senderId', 'type', 'idea', 'createdAt', 'clientTs']);
      }

      function isValidImageMessage() {
        let d = request.resource.data;
        return d.type == 'image'
          && d.storagePath is string
          // Must point INSIDE this couple's chat folder — no cross-couple refs.
          && d.storagePath.matches('^couples/' + coupleId + '/chatImages/[A-Za-z0-9]+\\.jpg$')
          && (!('width' in d) || (d.width is int && d.width > 0 && d.width <= 10000))
          && (!('height' in d) || (d.height is int && d.height > 0 && d.height <= 10000))
          && d.keys().hasOnly(
               ['senderId', 'type', 'storagePath', 'width', 'height', 'createdAt', 'clientTs']);
      }

      // Messages are immutable: no editing or deleting in the launch MVP,
      // which also means nobody can tamper with the partner's messages.
      match /messages/{messageId} {
        allow read: if isCoupleMember();
        allow create: if isCoupleMember()
          // The client cannot impersonate the partner …
          && request.resource.data.senderId == request.auth.uid
          // … nor backdate a message.
          && request.resource.data.createdAt == request.time
          && request.resource.data.clientTs is number
          && (isValidTextMessage() || isValidIdeaMessage() || isValidImageMessage());
        allow update, delete: if false;
      }

      // Per-user chat state documents. Each member may write ONLY their own
      // doc of each kind — never the partner's — and each kind has a fixed
      // shape:
      //   read_{uid}    lastReadAt + unread (unread may only be RESET to 0;
      //                 the count is incremented server-side)
      //   typing_{uid}  isTyping + updatedAt (updatedAt must be the server
      //                 time, so a stale doc cannot be made to look fresh)
      //   hearts_{uid}  {messageId: true, …} — this user's heart reactions.
      //                 Reactions live here, not on messages, so message
      //                 documents stay immutable. One key changes per write,
      //                 every value is `true`, and the doc is capped.
      // chat/meta is server-written (last message preview): it matches none
      // of these ids, so clients can only read it.
      function isOwnDoc(prefix, docId) {
        return docId == prefix + request.auth.uid;
      }

      function isValidReadState() {
        return request.resource.data.keys().hasOnly(['lastReadAt', 'unread'])
          && request.resource.data.lastReadAt is timestamp
          && request.resource.data.unread == 0;
      }

      function isValidTypingState() {
        return request.resource.data.keys().hasOnly(['isTyping', 'updatedAt'])
          && request.resource.data.isTyping is bool
          && request.resource.data.updatedAt == request.time;
      }

      function isValidHeartsState() {
        return request.resource.data.values().hasOnly([true])
          && request.resource.data.keys().size() <= 2000
          && (resource == null
                ? request.resource.data.keys().size() == 1
                : request.resource.data.diff(resource.data).affectedKeys().size() == 1);
      }

      match /chat/{docId} {
        allow read: if isCoupleMember();
        allow create, update: if isCoupleMember() && (
             (isOwnDoc('read_', docId)   && isValidReadState())
          || (isOwnDoc('typing_', docId) && isValidTypingState())
          || (isOwnDoc('hearts_', docId) && isValidHeartsState())
        );
        allow delete: if false;
      }
    }

    // ── Invites ───────────────────────────────────────────────────────────────
    // GET only, by exact code (the doc ID). The invite code is a shared pairing
    // secret; allowing LIST/query would let any signed-in user enumerate every
    // live code and join a stranger's pending couple. joinByCode() and
    // cancelInvite() only ever read a single invite by its code — a direct
    // document get, which this allows.
    //
    // Create is server-only: the createInvite Cloud Function writes invite docs
    // with the Admin SDK (which bypasses these rules). The client never creates
    // invites directly, so client creates are denied outright.
    //
    // Delete: invite creator, or an existing member of the couple (cancelInvite).
    match /invites/{inviteCode} {
      // GET is restricted to the invite's creator (used by the client
      // cancelInvite path). Redemption goes through the joinCouple callable
      // (Admin SDK), so a joiner never needs a client read. This closes the
      // former oracle where any authenticated user could read an invite by
      // code and learn its coupleId / inviter uid.
      allow get: if request.auth != null && request.auth.uid == resource.data.fromUserId;
      allow list: if false;
      allow create: if false;
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.fromUserId
        || request.auth.uid in get(
             /databases/$(database)/documents/couples/$(resource.data.coupleId)
           ).data.members
      );
    }

    // ── Ideas ─────────────────────────────────────────────────────────────────
    // All authenticated users can read idea documents (to fetch coverImageUrl).
    // Only the admin can write (upload cover URL after image upload to Storage).
    match /ideas/{ideaId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == '1RTxZHUV1NbvNlFsXhwl5LeEgFw1';
    }
  }
}
