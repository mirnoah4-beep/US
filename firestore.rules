rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Read: yourself, or your partner once you are both members of the same
      // couple. There is intentionally NO general "any signed-in user" clause.
      // The join handshake no longer reads the inviter's user doc — the
      // "inviter already partnered" guard moved to the cross-user update rule
      // below (coupleId == null), so nothing legitimately needs to read a
      // stranger's profile.
      allow read: if request.auth.uid == userId
        || (resource.data.coupleId != null
            && request.auth.uid in get(
                 /databases/$(database)/documents/couples/$(resource.data.coupleId)
               ).data.members);
      allow create, delete: if request.auth.uid == userId;
      // Own document only. Pairing (setting BOTH users' coupleId) and
      // disconnect/deletion are fully server-side (joinCouple, createInvite,
      // disconnectPartner, deleteAccount use the Admin SDK), so no client ever
      // needs to write another user's document. The former cross-user "join
      // handshake" clause was removed with the joinCouple callable.
      allow update: if request.auth.uid == userId;
    }

    // ── Couples ───────────────────────────────────────────────────────────────
    match /couples/{coupleId} {
      // Create is server-only: the createInvite Cloud Function creates the
      // pending couple doc with the Admin SDK. The client only joins (update)
      // or cancels (delete) an existing couple — it never creates one. This
      // also means clients cannot seed a server-owned field like
      // subscriptionTier at creation.
      allow create: if false;

      // Read: existing members, OR anyone authenticated when the couple is
      // still pending with a live invite — the joiner must read the doc to
      // verify status before committing.
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (resource.data.status == 'pending' &&
         resource.data.inviteCode != null &&
         exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode)))
      );

      // Update: existing members only (normal edits such as togetherSince or
      // streakRecord). Joining — adding a member and flipping the status to
      // active — is performed exclusively by the joinCouple callable with the
      // Admin SDK; the former client "join" clause was removed with it.
      allow update: if request.auth != null
        // subscriptionTier is server-owned — no client update may change it.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionTier'])
        && request.auth.uid in resource.data.members;

      // Delete: existing members only (used by cancelInvite).
      allow delete: if request.auth != null &&
        request.auth.uid in resource.data.members;

      // Subcollections: settings, lastTime, weeklyPlan, …
      //
      // `messages` and `chat` are carved OUT of this generic grant and get
      // their own stricter rules below. Overlapping matches are additive in
      // Firestore rules, so a broad allow here cannot be narrowed later — it
      // has to exclude them explicitly.
      match /{subcollection}/{docId} {
        allow read, write: if subcollection != 'messages'
          && subcollection != 'chat'
          && subcollection != 'settings'
          && request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/couples/$(coupleId)
          ).data.members;
      }

      // ── Settings ─────────────────────────────────────────────────────────
      // settings/main: couple-level document (legacy onboarding summary,
      // lifestyle, reminder toggles) — any member may read and write it.
      // settings/prefs_{uid}: ONE user's raw onboarding answers. Both
      // partners may read both, but a user may only create/update/delete
      // their own — a partner can never overwrite the other's answers.
      // Everything else under settings/ is closed.
      match /settings/{docId} {
        function isSettingsMember() {
          return request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/couples/$(coupleId)
            ).data.members;
        }
        function isOwnPrefs() {
          return docId == 'prefs_' + request.auth.uid;
        }
        function isValidPrefs() {
          let d = request.resource.data;
          return d.keys().hasOnly([
              'locationPreferences', 'pace', 'availableTime', 'isParent',
              'childcareState', 'bedtimeWeekday', 'bedtimeWeekend',
              'updatedAt', 'completedAt', 'schemaVersion'])
            && (!('locationPreferences' in d) || (d.locationPreferences is list && d.locationPreferences.size() <= 4))
            && (!('availableTime' in d) || d.availableTime in ['fewHours', 'evening', 'fullDay'])
            && (!('childcareState' in d) || d.childcareState in ['kidsHome', 'kidFree'])
            && (!('pace' in d) || d.pace in ['calm', 'mixed', 'active'])
            && (!('isParent' in d) || d.isParent is bool)
            && (!('bedtimeWeekday' in d) || d.bedtimeWeekday is string)
            && (!('bedtimeWeekend' in d) || d.bedtimeWeekend is string);
        }
        allow read: if isSettingsMember();
        allow write: if docId == 'main' && isSettingsMember();
        allow create, update: if docId.matches('^prefs_.*$') && isSettingsMember() && isOwnPrefs() && isValidPrefs();
        allow delete: if docId.matches('^prefs_.*$') && isSettingsMember() && isOwnPrefs();
      }

      // ── Chat ────────────────────────────────────────────────────────────
      // Membership is re-read from the couple document on every request, so
      // a former partner loses access the instant disconnectPartner removes
      // them from `members` — there is no cached grant to revoke.
      function isCoupleMember() {
        return request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/couples/$(coupleId)
          ).data.members;
      }

      function isValidTextMessage() {
        return request.resource.data.type == 'text'
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(
               ['senderId', 'type', 'text', 'createdAt', 'clientTs']);
      }

      function isValidIdeaMessage() {
        let idea = request.resource.data.idea;
        return request.resource.data.type == 'idea'
          && idea is map
          && idea.titleNo is string && idea.titleEn is string
          && idea.categoryNo is string && idea.categoryEn is string
          && idea.metaNo is string && idea.metaEn is string
          && idea.descriptionNo is string && idea.descriptionEn is string
          && (!('coverImageUrl' in idea) || idea.coverImageUrl is string)
          && idea.keys().hasOnly([
               'titleNo', 'titleEn', 'categoryNo', 'categoryEn',
               'metaNo', 'metaEn', 'descriptionNo', 'descriptionEn',
               'coverImageUrl'])
          && request.resource.data.keys().hasOnly(
               ['senderId', 'type', 'idea', 'createdAt', 'clientTs']);
      }

      function isValidImageMessage() {
        let d = request.resource.data;
        return d.type == 'image'
          && d.storagePath is string
          // Must point INSIDE this couple's chat folder — no cross-couple refs.
          && d.storagePath.matches('^couples/' + coupleId + '/chatImages/[A-Za-z0-9]+\\.jpg$')
          && (!('width' in d) || (d.width is int && d.width > 0 && d.width <= 10000))
          && (!('height' in d) || (d.height is int && d.height > 0 && d.height <= 10000))
          && d.keys().hasOnly(
               ['senderId', 'type', 'storagePath', 'width', 'height', 'createdAt', 'clientTs']);
      }

      // Messages are immutable: no editing or deleting in the launch MVP,
      // which also means nobody can tamper with the partner's messages.
      match /messages/{messageId} {
        allow read: if isCoupleMember();
        allow create: if isCoupleMember()
          // The client cannot impersonate the partner …
          && request.resource.data.senderId == request.auth.uid
          // … nor backdate a message.
          && request.resource.data.createdAt == request.time
          && request.resource.data.clientTs is number
          && (isValidTextMessage() || isValidIdeaMessage() || isValidImageMessage());
        allow update, delete: if false;
      }

      // Per-user chat state documents. Each member may write ONLY their own
      // doc of each kind — never the partner's — and each kind has a fixed
      // shape:
      //   read_{uid}    lastReadAt + unread (unread may only be RESET to 0;
      //                 the count is incremented server-side)
      //   typing_{uid}  isTyping + updatedAt (updatedAt must be the server
      //                 time, so a stale doc cannot be made to look fresh)
      //   hearts_{uid}  {messageId: true, …} — this user's heart reactions.
      //                 Reactions live here, not on messages, so message
      //                 documents stay immutable. One key changes per write,
      //                 every value is `true`, and the doc is capped.
      // chat/meta is server-written (last message preview): it matches none
      // of these ids, so clients can only read it.
      function isOwnDoc(prefix, docId) {
        return docId == prefix + request.auth.uid;
      }

      function isValidReadState() {
        return request.resource.data.keys().hasOnly(['lastReadAt', 'unread'])
          && request.resource.data.lastReadAt is timestamp
          && request.resource.data.unread == 0;
      }

      function isValidTypingState() {
        return request.resource.data.keys().hasOnly(['isTyping', 'updatedAt'])
          && request.resource.data.isTyping is bool
          && request.resource.data.updatedAt == request.time;
      }

      function isValidHeartsState() {
        return request.resource.data.values().hasOnly([true])
          && request.resource.data.keys().size() <= 2000
          && (resource == null
                ? request.resource.data.keys().size() == 1
                : request.resource.data.diff(resource.data).affectedKeys().size() == 1);
      }

      match /chat/{docId} {
        allow read: if isCoupleMember();
        allow create, update: if isCoupleMember() && (
             (isOwnDoc('read_', docId)   && isValidReadState())
          || (isOwnDoc('typing_', docId) && isValidTypingState())
          || (isOwnDoc('hearts_', docId) && isValidHeartsState())
        );
        allow delete: if false;
      }
    }

    // ── Invites ───────────────────────────────────────────────────────────────
    // GET only, by exact code (the doc ID). The invite code is a shared pairing
    // secret; allowing LIST/query would let any signed-in user enumerate every
    // live code and join a stranger's pending couple. joinByCode() and
    // cancelInvite() only ever read a single invite by its code — a direct
    // document get, which this allows.
    //
    // Create is server-only: the createInvite Cloud Function writes invite docs
    // with the Admin SDK (which bypasses these rules). The client never creates
    // invites directly, so client creates are denied outright.
    //
    // Delete: invite creator, or an existing member of the couple (cancelInvite).
    match /invites/{inviteCode} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if false;
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.fromUserId
        || request.auth.uid in get(
             /databases/$(database)/documents/couples/$(resource.data.coupleId)
           ).data.members
      );
    }

    // ── Ideas ─────────────────────────────────────────────────────────────────
    // All authenticated users can read idea documents (to fetch coverImageUrl).
    // Only the admin can write (upload cover URL after image upload to Storage).
    match /ideas/{ideaId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == '1RTxZHUV1NbvNlFsXhwl5LeEgFw1';
    }
  }
}
