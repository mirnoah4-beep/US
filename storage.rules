rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // NOTE: isCoupleMember/isPartnerOf/isAdmin use firestore.get()/exists().
    // Cross-service rules only work in production if the Firebase Storage
    // service agent (service-<project-number>@gcp-sa-firebasestorage.iam.
    // gserviceaccount.com) holds roles/firebaserules.firestoreServiceAgent.
    // The CLI grants it on an interactive deploy of a NEW ruleset
    // (`firebase deploy --only storage --interactive`); non-interactive and
    // AI-agent-driven deploys skip that check silently.
    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == '1RTxZHUV1NbvNlFsXhwl5LeEgFw1';
    }

    function isCoupleMember(coupleId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/couples/$(coupleId))
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/couples/$(coupleId)
        ).data.members;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Partner access is decided by the AUTHORITATIVE couple document, not by
    // comparing self-asserted coupleId fields. We resolve the TARGET user's
    // couple and require the requester to actually be in its `members`. This
    // means a caller cannot gain access by pointing their own users/{uid}
    // .coupleId at a victim's couple: the check never reads the requester's
    // own coupleId.
    function isPartnerOf(userId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(userId))
        && firestore.get(
             /databases/(default)/documents/users/$(userId)
           ).data.coupleId != null
        && isCoupleMember(
             firestore.get(
               /databases/(default)/documents/users/$(userId)
             ).data.coupleId
           );
    }

    // ---------- User avatars/files ----------
    match /users/{userId}/{allPaths=**} {
      // Owner, their linked partner, or admin. Display in-app goes through
      // tokened download URLs, so this only restricts direct SDK reads.
      allow read: if isAdmin()
        || request.auth.uid == userId
        || isPartnerOf(userId);

      // Only owner or admin can upload/update, and only valid images.
      allow create, update: if (isAdmin() || request.auth.uid == userId)
        && isValidImageUpload();

      // Delete has no request.resource, so keep separate.
      allow delete: if isAdmin() || request.auth.uid == userId;
    }

    // ---------- Idea images ----------
    match /ideas/{ideaId}/{allPaths=**} {
      // Any signed-in user can view idea images.
      allow read: if isSignedIn();

      // Only admin can upload/update valid idea images.
      allow create, update: if isAdmin() && isValidImageUpload();

      // Delete has no request.resource.
      allow delete: if isAdmin();
    }

    // ---------- Chat images ----------
    // Images sent in the 1:1 partner chat. The path is couple-scoped and the
    // file name is the Firestore message id, so a member of couple A can
    // never write into couple B's folder, and a message can only reference a
    // file in its own couple. Files are immutable once uploaded, like the
    // messages that point at them.
    match /couples/{coupleId}/chatImages/{fileName} {
      allow read: if isCoupleMember(coupleId);

      // One `write` rule gated on `resource == null` makes immutability
      // explicit: a brand-new object passes, an overwrite (resource exists)
      // and a delete (no request.resource, so isValidImageUpload fails) are
      // denied — independent of how the runtime classifies the operation.
      allow write: if resource == null
        && isCoupleMember(coupleId)
        && isValidImageUpload()
        && fileName.matches('^[A-Za-z0-9]+\\.jpg$');
    }

    // ---------- Couple memories ----------
    match /couples/{coupleId}/memories/{fileName} {
      // Only admin or actual members of this couple.
      allow read: if isAdmin() || isCoupleMember(coupleId);

      // Admin and couple members can upload/update, but only valid images.
      allow create, update: if (isAdmin() || isCoupleMember(coupleId))
        && isValidImageUpload();

      // Delete has no request.resource.
      allow delete: if isAdmin() || isCoupleMember(coupleId);
    }
  }
}
