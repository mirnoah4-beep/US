{
  "name": "functions",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "tsc && node --test lib/__tests__/*.test.js",
    "test:rules": "tsc && firebase emulators:exec --only firestore --project us-app-4bf30 \"node --test lib/__rules__/*.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20.0.0",
    "firebase": "^12.19.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
